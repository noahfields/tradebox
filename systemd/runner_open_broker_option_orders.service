[Unit]
Description=runner open_broker_option_orders
After=network.target

[Service]
Type=simple
User=nfields
WorkingDirectory=/home/nfields/tradebox/tradebox
ExecStart=/home/nfields/venvs/tradeboxvenv/bin/python /home/nfields/app/tradebox/tradebox/runners.py open_broker_option_orders
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target