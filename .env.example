# Tradebox Docker Environment Configuration
# Copy this file to .env and fill in your credentials

TRADEBOX_PUBLIC_URL=http://127.0.0.1/

# PostgreSQL Configuration
DB_USER=dev
DB_PASSWORD=dev
DB_NAME=tradebox
DB_PORT=5432

# Robinhood Credentials
ROBINHOOD_USERNAME=your_robinhood_email
ROBINHOOD_PASSWORD=your_robinhood_password

# Notification Settings (Pushover)
PUSHOVER_USER_TOKEN=your_pushover_user_token
PUSHOVER_API_TOKEN=your_pushover_api_token

# Refresh Intervals (seconds)
MARKET_DATA_REFRESH_INTERVAL=3
OPEN_POSITIONS_REFRESH_INTERVAL=5
BROKER_ORDERS_REFRESH_INTERVAL=15
INSTRUMENT_DATA_REFRESH_INTERVAL=5
MAXIMUM_INTERVAL=30
RUNNER_FAILURE_ADJUSTMENT=3
RUNNER_SUCCESS_ADJUSTMENT=1

# Logging Configuration
LOG_LEVEL=INFO
FILE_LOGGING=1
STDOUT_LOGGING=1
JSONL_LOGGING=1

# DEBUG ENVIRONMENT SETTINGS
DEVELOPMENT_FLASK_IP=127.0.0.1
DEVELOPMENT_FLASK_PORT=5555
DEVELOPMENT_FLASK_DEBUG=True