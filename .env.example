# Tradebox Docker Environment Configuration
# Copy this file to .env and fill in your credentials

# PostgreSQL Configuration
DB_USER=tradebox
DB_PASSWORD=changeme_in_production
DB_NAME=tradebox
DB_PORT=5432

# Robinhood Credentials
ROBINHOOD_USERNAME=your_username@example.com
ROBINHOOD_PASSWORD=your_password

# Notification Settings (Pushover)
PUSHOVER_USER_TOKEN=
PUSHOVER_API_TOKEN=

# Nginx Configuration
DOMAIN_NAME=localhost
NGINX_DEV_PORT=8898
SSL_CERT_DIR=./certs

# Refresh Intervals (seconds)
MARKET_DATA_REFRESH_INTERVAL=5
OPEN_POSITIONS_REFRESH_INTERVAL=5
BROKER_ORDERS_REFRESH_INTERVAL=15
MAXIMUM_INTERVAL=60

# Logging Configuration
LOG_LEVEL=INFO
FILE_LOGGING=1
STDOUT_LOGGING=1
