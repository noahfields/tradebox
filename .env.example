# Tradebox Docker Environment Configuration
# Copy this file to .env and fill in your credentials

TRADEBOX_APP_ADDRESS=http://127.0.0.1/

# PostgreSQL Configuration
DB_USER=tradebox
DB_PASSWORD=dev
DB_NAME=tradebox
DB_PORT=5432

# Robinhood Credentials
ROBINHOOD_USERNAME=your_robinhood_email@example.com
ROBINHOOD_PASSWORD=your_robinhood_password

# Notification Settings (Pushover)
PUSHOVER_USER_TOKEN=your_pushover_user_token
PUSHOVER_API_TOKEN=your_pushover_api_token

# Nginx Configuration
DOMAIN_NAME=localhost
NGINX_DEV_PORT=8898
SSL_CERT_DIR=./certs

# Refresh Intervals (seconds)
MARKET_DATA_REFRESH_INTERVAL=5
OPEN_POSITIONS_REFRESH_INTERVAL=5
BROKER_ORDERS_REFRESH_INTERVAL=15
MAXIMUM_INTERVAL=60
RUNNER_FAILURE_ADJUSTMENT=5
RUNNER_SUCCESS_ADJUSTMENT=1

# Logging Configuration
LOG_LEVEL=INFO
FILE_LOGGING=1
STDOUT_LOGGING=1
JSONL_LOGGING=1

# DEBUG ENVIRONMENT SETTINGS
DEV_FLASK_IP='127.0.0.1'
DEV_FLASK_PORT=5555
DEV_FLASK_DEBUG=True

LOG_PARENT_DIR = '.'
LOG_DIR_NAME = 'logs'
